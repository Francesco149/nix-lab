#!/usr/bin/env bash
# vision — ask a vision model what an image/video contains.
# DEFAULT: OpenRouter qwen/qwen3.5-9b (needs OPENROUTER_API_KEY in
# ~/.omp/agent/.env). FALLBACK: the local lame model (7800XT) — with the
# wake/confirm protocol below.
#
#   vision --check                     # state probe (passive, no wake)
#   vision <image-or-video> [prompt]   # single media item
#   vision --video <file> [--chunk 30] # long video: local chunk+join
#   vision -                           # read the media from stdin (binary)
#
# Fallback state protocol (when OpenRouter fails and we go local):
#   VISION_STATE=ok     — local vision model healthy on lame:8080; proceed.
#   VISION_STATE=switch — lame is up but vision is NOT running (something
#                         else is on the GPU, or it is idle). DO NOT switch
#                         automatically: STOP and ask the human to confirm
#                         `ssh root@lame gpu-switch run vision` (switching
#                         would kill whatever is currently running there).
#   VISION_STATE=down   — lame unreachable, even after a cold-unlock attempt.
#                         Keep going WITHOUT vision and tell the human vision
#                         is down (wake was attempted: cold-unlock --host lame).
#
# Exit codes: 0 = answered (OR or local), 3 = switch-needed, 4 = down.
#
# Env knobs: VISION_LAME (root@10.0.10.56), VISION_CODE (root@10.0.10.53),
# VISION_ALIAS (qwen3.5-9b), VISION_WAKE_TIMEOUT (90), VISION_OR_MODEL,
# OPENROUTER_API_KEY.
set -euo pipefail

LAME="${VISION_LAME:-root@10.0.10.56}"
CODE="${VISION_CODE:-root@10.0.10.53}"
ALIAS="${VISION_ALIAS:-qwen3.5-9b}"
PORT=8080
WAKE_TIMEOUT="${VISION_WAKE_TIMEOUT:-90}"
OR_MODEL="${VISION_OR_MODEL:-qwen/qwen3.5-9b}"
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# API key lives OUTSIDE the repo, in omp's .env (same place as DEEPSEEK_API_KEY).
# An explicitly exported OPENROUTER_API_KEY wins over the file.
if [ -f "$HOME/.omp/agent/.env" ] && [ -z "${OPENROUTER_API_KEY:-}" ]; then
  set -a; . "$HOME/.omp/agent/.env"; set +a
fi

PYRUN() { nix shell nixpkgs#python3 --command python3 "$@"; }

lame_up() { ssh -o ConnectTimeout=6 -o BatchMode=yes "$LAME" true 2>/dev/null; }

vision_alias() {
  ssh -o ConnectTimeout=6 "$LAME" \
    "curl -sf http://127.0.0.1:$PORT/v1/models 2>/dev/null | sed -n 's/.*\"id\":\"\([^\"]*\)\".*/\1/p' | head -1" 2>/dev/null || true
}

gpu_state() {
  ssh -o ConnectTimeout=6 "$LAME" \
    "/opt/ai-lab/gpu-switch/gpu-switch status 2>/dev/null | head -6" 2>/dev/null \
    || echo "(cannot read gpu-switch status)"
}

check_state() { # ok | switch | down
  if ! lame_up; then echo "down"; return; fi
  if [ "$(vision_alias)" = "$ALIAS" ]; then echo "ok"; return; fi
  echo "switch"
}

wake_lame() {
  local deadline=$((SECONDS + WAKE_TIMEOUT))
  echo "vision: lame is down — waking it via code (cold-unlock --host lame --stay, timeout ${WAKE_TIMEOUT}s)..." >&2
  timeout "$WAKE_TIMEOUT" ssh -o ConnectTimeout=6 "$CODE" "cold-unlock --host lame --stay" >&2 || true
  while [ $SECONDS -lt $deadline ]; do
    if lame_up; then
      state="$(check_state)"
      [ "$state" != "down" ] && return 0
    fi
    sleep 2
  done
  return 1
}

print_switch() {
  echo "VISION_STATE=switch"
  echo "vision: lame is up but the vision model is NOT running on :$PORT."
  echo "What is on lame right now:"
  gpu_state | sed 's/^/  /'
  echo
  echo "MODEL INSTRUCTION: do NOT switch lame to vision yourself — switching"
  echo "would kill whatever is currently running there. STOP and ask the human"
  echo "to confirm:  ssh root@lame gpu-switch run vision"
}

print_down() {
  echo "VISION_STATE=down"
  echo "vision: lame is unreachable even after a wake attempt"
  echo "(cold-unlock --host lame --stay)."
  echo
  echo "MODEL INSTRUCTION: keep going WITHOUT vision, and tell the human that"
  echo "vision is down (wake was attempted automatically and timed out)."
}

or_ok() {
  [ -n "${OPENROUTER_API_KEY:-}" ]
}

# stage media: returns via /tmp/vision-ext + /tmp/vision-b64 + /tmp/vision-prompt
stage_media() { # media prompt...
  local media="$1"; shift || true
  local prompt="$*"
  local src="$media" tmp=""
  if [ "$src" = "-" ]; then
    tmp=$(mktemp --suffix=.bin); cat > "$tmp"; src="$tmp"
  fi
  [ -f "$src" ] || { echo "vision: no such file: $src" >&2; exit 1; }
  echo "${src##*.}" > /tmp/vision-ext
  base64 -w0 < "$src" > /tmp/vision-b64
  echo "$prompt" > /tmp/vision-prompt
  if [ -n "$tmp" ]; then rm -f "$tmp"; fi
}

send_openrouter() { # media prompt...
  if ! or_ok; then
    echo "vision: OPENROUTER_API_KEY not set — using local model" >&2
    return 1
  fi
  stage_media "$@"
  echo "vision: openrouter ($OR_MODEL)..." >&2
  OPENROUTER_API_KEY="$OPENROUTER_API_KEY" VISION_OR_MODEL="$OR_MODEL" PYRUN "$HERE/vision-openrouter.py" "$2" < /tmp/vision-b64
}

send_local() { # media prompt... (state must be ok)
  local media="$1"; shift || true
  local prompt="$*"
  if [ "$media" = "--video" ]; then
    # long-video chunk+join: local pipeline only
    local file="${1:?usage: vision --video <file> [--chunk N]}"
    shift || true
    [ -f "$file" ] || { echo "vision: no such file: $file" >&2; exit 1; }
    scp -q -o ConnectTimeout=10 "$file" "$LAME:/tmp/vision-video.bin"
    ssh "$LAME" "nix-shell -p python3 ffmpeg --run 'python3 /opt/ai-lab/gpu-switch/video-summarize.py /tmp/vision-video.bin $*'"
    return
  fi
  stage_media "$media" "$prompt"
  cat /tmp/vision-b64 | ssh "$LAME" "cat > /tmp/vision-b64"
  echo "$(cat /tmp/vision-ext)" | ssh "$LAME" "cat > /tmp/vision-ext"
  echo "$(cat /tmp/vision-prompt)" | ssh "$LAME" "cat > /tmp/vision-prompt"
  ssh "$LAME" "nix-shell -p python3 --run 'python3 /opt/ai-lab/gpu-switch/vision-cli.py \"\$(cat /tmp/vision-prompt)\"' < /tmp/vision-b64"
}

local_gate() { # runs the fallback state machine; exits if not ok
  case "$(check_state)" in
    ok) return 0 ;;
    switch) print_switch; exit 3 ;;
    down)
      if ! wake_lame; then print_down; exit 4; fi
      case "$(check_state)" in
        ok) return 0 ;;
        switch) print_switch; exit 3 ;;
        down) print_down; exit 4 ;;
      esac
      ;;
  esac
}

cmd_use() { # media prompt...
  # long-video chunk+join: local pipeline only (OpenRouter has no chunk mode)
  if [ "${1:-}" = "--video" ]; then
    local_gate
    send_local "$@"
    return
  fi
  # default: OpenRouter; on ANY failure fall back to the local model
  if send_openrouter "$@"; then
    echo "vision: answered via openrouter" >&2
    return 0
  fi
  echo "vision: OpenRouter failed (see above) — falling back to local lame model" >&2
  local_gate
  send_local "$@"
}

cmd_check() {
  echo "openrouter: $([ -n "${OPENROUTER_API_KEY:-}" ] && echo "key set ($OR_MODEL)" || echo "NO KEY — local only")"
  case "$(check_state)" in
    ok) echo "VISION_STATE=ok"; echo "local: $ALIAS healthy on ${LAME#*@}:$PORT" ;;
    switch) print_switch; exit 3 ;;
    down) print_down; exit 4 ;;
  esac
}

case "${1:-}" in
  --check) cmd_check ;;
  -h|--help) sed -n '2,40p' "$0" ;;
  *) cmd_use "$@" ;;
esac
